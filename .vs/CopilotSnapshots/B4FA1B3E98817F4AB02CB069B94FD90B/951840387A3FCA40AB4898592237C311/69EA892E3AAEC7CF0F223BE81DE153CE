@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Sách Nổi Tiếng</h1>
    <p>Danh sách sách được yêu thích nhất</p>
    <button type="button" class="btn btn-primary btn-lg" id="btnLoadBooks">
        Tải Sách Nổi Tiếng
    </button>
</div>

<div id="booksContainer" style="margin-top: 30px;">
    <!-- Books will be loaded here by AJAX -->
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            // Handle button click to load popular books
            $("#btnLoadBooks").click(function() {
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("PopularBook", "Book")",
                    dataType: "html",
                    success: function(result) {
                        $("#booksContainer").html(result);
                    },
                    error: function(xhr, status, error) {
                        console.log("Error: " + error);
                        $("#booksContainer").html("<p class='text-danger'>Lỗi khi tải dữ liệu</p>");
                    }
                });
            });
        });
    </script>
}


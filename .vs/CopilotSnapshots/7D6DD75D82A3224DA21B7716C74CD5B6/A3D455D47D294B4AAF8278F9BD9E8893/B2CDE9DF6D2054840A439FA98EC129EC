@using Bài_tập_tự_làm.Models

@{
    ViewData["Title"] = "Sản Phẩm Nồi Điện Nagakawa";
    var categories = ViewData["Categories"] as List<Category> ?? new List<Category>();
    var products = ViewData["Products"] as List<Product> ?? new List<Product>();
}

<!-- Navbar -->
<nav class="navbar navbar-light bg-dark navbar-expand-lg mb-4">
    <div class="container-fluid">
        <a class="navbar-brand text-white fw-bold" href="#">NAGAKAWA</a>
        <span class="navbar-text text-white">Danh mục | Sản phẩm | Thương hiệu</span>
    </div>
</nav>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar - Danh Mục -->
        <div class="col-md-3 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white fw-bold">
                    Danh Mục Sản Phẩm
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("_CategoryList", categories)
                </div>
            </div>
        </div>

        <!-- Main Content - Sản Phẩm Chính -->
        <div class="col-md-9">
            <div class="row mb-4">
                <div class="col">
                    <h4 class="mb-4">Danh Sách Sản Phẩm</h4>
                </div>
            </div>

            <!-- Grid sản phẩm - 3 cột -->
            <div class="row mb-5">
                @foreach (var product in products.Where(p => !p.IsHot).Take(6))
                {
                    <div class="col-md-4 mb-4">
                        <div class="card product-card h-100">
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h6 class="card-title">@product.Name</h6>
                                <p class="card-text small text-muted">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-danger fw-bold">@string.Format("{0:N0}", product.Price) đ</span>
                                </div>
                            </div>
                            <div class="card-footer bg-light">
                                <a href="#" class="btn btn-warning btn-sm w-100">Load or View Action</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Sản phẩm nóng bỏng (từ Component) -->
            <hr class="my-4" />

            @await Component.InvokeAsync("HotProduct")
        </div>
    </div>
</div>

<!-- Footer thông tin -->
<hr class="my-5" />
<div class="row bg-dark text-white p-4 mt-5 mx-0">
    <div class="col-md-6">
        <h6>GIỚI THIỆU</h6>
        <p>Công ty sản xuất các sản phẩm điện gia dụng chất lượng cao, được nhiều gia đình tin tưởng sử dụng.</p>
    </div>
    <div class="col-md-6">
        <h6>LIÊN HỆ</h6>
        <p>Hotline: 1900-XXXX | Email: contact@nagakawa.com</p>
    </div>
</div>

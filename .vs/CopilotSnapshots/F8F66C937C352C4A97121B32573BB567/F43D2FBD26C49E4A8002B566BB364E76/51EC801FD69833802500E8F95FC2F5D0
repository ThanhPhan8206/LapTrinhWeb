@{
    ViewData["Title"] = "Thanh Phan";
}

<div class="hero bg-light py-5 mb-4">
    <div class="container text-center">
        <h1 class="display-4">Welcome to DevStore</h1>
        <p class="lead">A simple demo of ASP.NET Core MVC showing a hero banner and product cards.</p>
        <p><a class="btn btn-primary btn-lg" href="/Product">Browse Products</a></p>
    </div>
</div>


html {
  font-size: 14px;
}

@media (min-width: 768px) {
  html {
    font-size: 16px;
  }
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

html {
  position: relative;
  min-height: 100%;
}

body {
  margin-bottom: 60px;
}

.form-floating > .form-control-plaintext::placeholder, .form-floating > .form-control::placeholder {
  color: var(--bs-secondary-color);
  text-align: end;
}

.form-floating > .form-control-plaintext:focus::placeholder, .form-floating > .form-control:focus::placeholder {
  text-align: start;
}

/* Hero and product card tweaks for demo */
.top-strip { height: 8px; background: #0b0b0b; }
.navbar-dark .navbar-brand { color: #f8f9fa; }

/* Carousel banner styles */
.carousel-banner-bg {
  background: linear-gradient(135deg, #0052cc 0%, #0078d4 100%);
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30px 40px;
  position: relative;
}

.carousel-banner-content {
  flex: 1;
  text-align: center;
  color: white;
  position: relative;
  z-index: 10;
}

.banner-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-bottom: 16px;
}

.banner-header h4 {
  margin: 0;
  font-size: 20px;
  font-weight: 600;
  color: #fff;
}

.banner-divider {
  color: #76b3e8;
  margin: 0 8px;
  opacity: 0.7;
}

.banner-icons {
  display: flex;
  gap: 10px;
  align-items: center;
}

.banner-icons svg {
  color: #fff;
  opacity: 0.9;
}

.banner-description {
  margin: 0 0 16px 0;
  font-size: 14px;
  line-height: 1.5;
  color: #e8f0f8;
  max-width: 600px;
}

.carousel-control-prev, .carousel-control-next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: auto;
  height: auto;
  background: none;
  border: none;
  opacity: 0.7;
  transition: opacity 0.3s ease;
  z-index: 15;
}

.carousel-control-prev:hover, .carousel-control-next:hover {
  opacity: 1;
}

.carousel-control-prev {
  left: 10px;
}

.carousel-control-next {
  right: 10px;
}

.carousel-control-prev-icon, .carousel-control-next-icon {
  width: 30px;
  height: 30px;
  background-size: contain;
}

.carousel-indicators {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
}

.carousel-indicators button {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
  border: none;
  margin: 0 5px;
}

.carousel-indicators button.active {
  background-color: #fff;
}

.product-card { background: #fff; border: 1px solid #e9ecef; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
.product-card img { max-height: 160px; object-fit: contain; }
.product-card .card-body { padding-top: 0.5rem; }
.product-card .card-title { font-size: 0.95rem; margin-bottom: 0.2rem; }
.product-card .card-text { font-size: 0.85rem; color: #6c757d; }
table.table img { border: 1px solid #e9ecef; padding: 4px; background: #fff; }

/* Footer tweak */
.footer { background: transparent; }


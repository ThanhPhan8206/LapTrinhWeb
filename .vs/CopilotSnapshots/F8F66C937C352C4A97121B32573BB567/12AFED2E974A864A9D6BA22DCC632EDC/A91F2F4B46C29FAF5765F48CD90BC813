@model IEnumerable<WebAppDEMO.Models.Product>

@{
    ViewData["Title"] = "Thanh Phan";
    var productList = Model?.ToList() ?? new List<WebAppDEMO.Models.Product>();
}

<div id="mainCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="carousel-banner-bg">
                <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>

                <div class="carousel-banner-content">
                    <div class="banner-header">
                        <h4>Microsoft Azure</h4>
                        <span class="banner-divider">|</span>
                        <div class="banner-icons">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><path d="M12 2 L22 8 L22 16 L12 22 L2 16 L2 8 Z" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><rect x="2" y="2" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><rect x="2" y="2" width="9" height="9" stroke="currentColor" stroke-width="2" fill="none"/><rect x="13" y="2" width="9" height="9" stroke="currentColor" stroke-width="2" fill="none"/><rect x="2" y="13" width="9" height="9" stroke="currentColor" stroke-width="2" fill="none"/><rect x="13" y="13" width="9" height="9" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                        </div>
                    </div>

                    <p class="banner-description">Learn how Microsoft's Azure cloud platform allows you to build, deploy, and scale web apps.</p>

                    <a class="btn btn-sm btn-light" href="#">Learn More</a>
                </div>

                <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <h2 class="mb-3">Danh sách sản phẩm</h2>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var product in productList)
        {
            <div class="col">
                <div class="card h-100 text-center product-card">
                    <img src="@product.ImageUrl" class="card-img-top mx-auto p-3" style="height:160px; object-fit:contain;" alt="@product.Name">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@string.Format("{0:N0} đ", product.Price)</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

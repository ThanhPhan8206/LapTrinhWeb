@model IEnumerable<WebAppDEMO.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container">
    <h1 class="mb-4">Product list</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Created At</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>@string.Format("{0:N0} đ", p.Price)</td>
                    <td>@p.CreatedAt.ToString("dd-MM-yyyy")</td>
                    <td><img src="@p.ImageUrl" alt="@p.Name" style="width:60px;" /></td>
                    <td><a class="btn btn-sm btn-success" href="#">View</a></td>
                </tr>
            }
        </tbody>
    </table>

    <a class="btn btn-success" href="#">Create new product</a>
</div>

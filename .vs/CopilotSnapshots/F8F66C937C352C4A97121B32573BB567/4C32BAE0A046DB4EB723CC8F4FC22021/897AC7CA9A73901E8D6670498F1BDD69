html {
  font-size: 14px;
}

@media (min-width: 768px) {
  html {
    font-size: 16px;
  }
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

html {
  position: relative;
  min-height: 100%;
}

body {
  margin-bottom: 60px;
}

.form-floating > .form-control-plaintext::placeholder, .form-floating > .form-control::placeholder {
  color: var(--bs-secondary-color);
  text-align: end;
}

.form-floating > .form-control-plaintext:focus::placeholder, .form-floating > .form-control:focus::placeholder {
  text-align: start;
}

/* Hero and product card tweaks for demo */
.top-strip { height: 8px; background: #0b0b0b; }
.navbar-dark .navbar-brand { color: #f8f9fa; }
.carousel-caption { text-align: left; left: 5%; right: 50%; }
.product-card { background: #fff; border: 1px solid #e9ecef; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
.product-card img { max-height: 160px; object-fit: contain; }
.product-card .card-body { padding-top: 0.5rem; }
.product-card .card-title { font-size: 0.95rem; margin-bottom: 0.2rem; }
.product-card .card-text { font-size: 0.85rem; color: #6c757d; }
table.table img { border: 1px solid #e9ecef; padding: 4px; background: #fff; }

/* Footer tweak */
.footer { background: transparent; }


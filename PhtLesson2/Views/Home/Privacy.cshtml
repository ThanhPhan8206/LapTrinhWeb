@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container my-5">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>

    <!-- Đoạn mở đầu ngắn gọn -->
    <section class="text-center mb-5">
        <p class="lead">
            Chào mừng bạn đến với cửa hàng túi xách trực tuyến của chúng tôi. Chúng tôi chuyên cung cấp các mẫu túi xách cao cấp, hiện đại, đáp ứng mọi nhu cầu từ không gian công sở chuyên nghiệp đến những buổi dạo phố năng động.
        </p>
    </section>

    <!-- Rút gọn lý do chọn cửa hàng thành 3 cột nổi bật -->
    <section class="row mt-4">
        <div class="col-md-4 text-center">
            <h5 class="text-primary">✨ Đa dạng phong cách</h5>
            <p>Liên tục cập nhật những xu hướng túi xách mới nhất trên thế giới.</p>
        </div>
        <div class="col-md-4 text-center">
            <h5 class="text-primary">💎 Chất lượng cao cấp</h5>
            <p>Từng sản phẩm đều được kiểm tra kỹ lưỡng, đảm bảo độ bền tối ưu.</p>
        </div>
        <div class="col-md-4 text-center">
            <h5 class="text-primary">🚚 Dịch vụ tận tâm</h5>
            <p>Giao hàng nhanh chóng và hỗ trợ đổi trả miễn phí trong 30 ngày.</p>
        </div>
    </section>

    <!-- Thông tin liên hệ rút gọn -->
    <section class="mt-5 text-center">
        <hr />
        <p class="mt-4">
            <strong>📧 Email:</strong> support@handbagstore.com &nbsp;|&nbsp;
            <strong>📞 Hotline:</strong> (123) 456-7890
        </p>
        <p class="text-muted"><small>Giờ mở cửa: Thứ 2 - Chủ Nhật, 09:00 - 21:00</small></p>
    </section>
</div>